# Backend (read by backend/config.py). All optional; defaults shown.
LIGHTSAFE_HOST=127.0.0.1
LIGHTSAFE_PORT=8000
LIGHTSAFE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (set in frontend/.env.local). Leave unset to use the Vite dev proxy (/api -> :8000).
# VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Set to 0 to switch off the repair-pressure (ML) context; everything else is unaffected.
LIGHTSAFE_ML_ENABLED=1
